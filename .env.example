# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when serving over HTTPS, e.g. https://notes.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
# Production only
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_PROXY=False
DJANGO_HSTS_SECONDS=31536000
DJANGO_ADMIN_URL=admin/
DJANGO_DB_PATH=
# Optional PostgreSQL URL, e.g. postgres://user:password@host:5432/ember
DATABASE_URL=
DB_CONN_MAX_AGE=60
# Optional Redis URL for a shared cache/rate-limit cache in multi-worker deployments
CACHE_URL=
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
DJANGO_LOG_LEVEL=INFO
# Production SMTP for password-reset email
DEFAULT_FROM_EMAIL=Ember Notes <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
