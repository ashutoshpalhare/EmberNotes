# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=True
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when serving over HTTPS, e.g. https://notes.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
# Production only
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_PROXY=False
DJANGO_HSTS_SECONDS=31536000
DJANGO_ADMIN_URL=admin/
DJANGO_DB_PATH=
DJANGO_LOG_LEVEL=INFO
